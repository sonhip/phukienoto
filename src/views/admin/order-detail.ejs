<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>* { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-100 min-h-screen">
  <header class="bg-gray-900 text-white py-3 px-4">
    <div class="max-w-4xl mx-auto flex items-center justify-between">
      <a href="/admin" class="flex items-center gap-2 text-sm font-bold">
        <i class="fas fa-arrow-left"></i> Quay Lại Dashboard
      </a>
      <span class="text-xs text-gray-400">Chi tiết đơn hàng</span>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-8">
    <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-200">
      
      <!-- Order Header -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-6 border-b border-gray-100">
        <div>
          <h1 class="text-xl font-black text-gray-900">Đơn Hàng #<%= order.order_code %></h1>
          <p class="text-xs text-gray-500 mt-1">Ngày tạo: <%= new Date(order.created_at).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
        </div>
        <% const statusInfo = ORDER_STATUS_LABELS[order.order_status] || { label: order.order_status, color: 'bg-gray-100 text-gray-800' }; %>
        <span class="text-sm font-bold px-4 py-2 rounded-xl border <%= statusInfo.color %>">
          <%= statusInfo.label %>
        </span>
      </div>

      <!-- Customer Info -->
      <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div class="bg-gray-50 p-4 rounded-2xl">
          <h3 class="font-bold text-gray-900 text-sm mb-3"><i class="fas fa-user text-orange-500 mr-2"></i>Thông Tin Khách Hàng</h3>
          <div class="space-y-2 text-xs text-gray-700">
            <p><strong>Họ tên:</strong> <%= order.customer_name %></p>
            <p><strong>SĐT:</strong> <a href="tel:<%= order.customer_phone %>" class="text-blue-600 font-bold"><%= order.customer_phone %></a></p>
            <p><strong>Địa chỉ:</strong> <%= order.customer_address %></p>
            <% if (order.customer_note) { %>
            <p><strong>Ghi chú:</strong> <span class="text-orange-600 italic"><%= order.customer_note %></span></p>
            <% } %>
          </div>
        </div>

        <div class="bg-gray-50 p-4 rounded-2xl">
          <h3 class="font-bold text-gray-900 text-sm mb-3"><i class="fas fa-credit-card text-orange-500 mr-2"></i>Thanh Toán</h3>
          <div class="space-y-2 text-xs text-gray-700">
            <p><strong>Phương thức:</strong> <%= order.payment_method === 'BANK_TRANSFER' ? 'Chuyển Khoản Ngân Hàng' : 'COD - Thanh toán khi nhận' %></p>
            <p><strong>Trạng thái TT:</strong> <%= order.payment_status %></p>
            <% if (order.transfer_content) { %>
            <p><strong>Nội dung CK:</strong> <span class="font-mono font-bold text-orange-600"><%= order.transfer_content %></span></p>
            <% } %>
            <p><strong>Tổng tiền:</strong> <span class="text-red-600 font-black text-base"><%= formatCurrency(order.total_amount) %></span></p>
          </div>
        </div>
      </div>

      <!-- Order Items -->
      <h3 class="font-bold text-gray-900 text-sm mb-3"><i class="fas fa-box text-orange-500 mr-2"></i>Sản Phẩm Đặt Mua</h3>
      <div class="space-y-3 mb-8">
        <% order.items.forEach(item => { %>
        <div class="flex items-center gap-4 bg-gray-50 p-3 rounded-xl">
          <img src="<%= item.image %>" alt="<%= item.name %>" class="w-14 h-14 rounded-lg object-cover bg-gray-200">
          <div class="flex-1">
            <p class="font-bold text-gray-900 text-sm"><%= item.name %></p>
            <p class="text-xs text-gray-500">Số lượng: <%= item.quantity %> | Đơn giá: <%= formatCurrency(item.price) %></p>
          </div>
          <span class="font-black text-red-600 text-sm"><%= formatCurrency(item.price * item.quantity) %></span>
        </div>
        <% }) %>
      </div>

      <!-- Update Status -->
      <div class="border-t border-gray-100 pt-6">
        <h3 class="font-bold text-gray-900 text-sm mb-3"><i class="fas fa-edit text-orange-500 mr-2"></i>Cập Nhật Trạng Thái</h3>
        <form action="/admin/order/<%= order.id %>/status" method="POST" class="flex items-center gap-3">
          <select name="status" class="border border-gray-300 rounded-xl px-4 py-2.5 text-sm font-bold focus:ring-2 focus:ring-orange-500 outline-none bg-white flex-1">
            <option value="PRIORITY_QUEUE" <%= order.order_status === 'PRIORITY_QUEUE' ? 'selected' : '' %>>⚡ Chuyển Khoản (Check CK)</option>
            <option value="PENDING" <%= order.order_status === 'PENDING' ? 'selected' : '' %>>⏳ Chờ Xác Nhận (COD)</option>
            <option value="CONFIRMED" <%= order.order_status === 'CONFIRMED' ? 'selected' : '' %>>📦 Đã Đóng Gói</option>
            <option value="SHIPPING" <%= order.order_status === 'SHIPPING' ? 'selected' : '' %>>🚚 Đang Giao Hàng</option>
            <option value="DELIVERED" <%= order.order_status === 'DELIVERED' ? 'selected' : '' %>>✅ Giao Thành Công</option>
            <option value="CANCELLED" <%= order.order_status === 'CANCELLED' ? 'selected' : '' %>>❌ Đã Hủy</option>
          </select>
          <button type="submit" class="bg-gradient-to-r from-orange-500 to-red-600 text-white font-bold px-6 py-2.5 rounded-xl text-sm shadow hover:opacity-95 transition">
            Cập Nhật
          </button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
