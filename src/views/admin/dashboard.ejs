<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>* { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-100 min-h-screen">
  <!-- Top Admin Navbar -->
  <header class="bg-gray-900 text-white sticky top-0 z-30 shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 bg-orange-500 rounded-xl flex items-center justify-center font-black">
            <i class="fas fa-car"></i>
          </div>
          <div>
            <h1 class="text-base font-bold leading-none">SmartLifeHub Admin</h1>
            <p class="text-[10px] text-gray-400">Hệ Thống Quản Lý Bán Hàng</p>
          </div>
        </div>

        <nav class="hidden md:flex items-center gap-2">
          <a href="/admin" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-orange-500 text-white">
            <i class="fas fa-shopping-bag mr-1"></i> Xử Lý Đơn
          </a>
          <a href="/admin/analytics" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-300 hover:bg-gray-800 hover:text-white transition">
            <i class="fas fa-chart-pie mr-1"></i> Báo Cáo Doanh Thu
          </a>
          <a href="/admin/products" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-300 hover:bg-gray-800 hover:text-white transition">
            <i class="fas fa-box-open mr-1"></i> Quản Lý Sản Phẩm
          </a>
          <a href="/admin/media" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-300 hover:bg-gray-800 hover:text-white transition">
            <i class="fas fa-folder-open mr-1"></i> Thư Viện Media
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-4">
        <a href="/" target="_blank" class="text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold px-3 py-2 rounded-lg transition">
          <i class="fas fa-external-link-alt mr-1"></i> Xem Web
        </a>
        <a href="/admin/logout" class="text-xs bg-red-600 hover:bg-red-700 text-white font-semibold px-3 py-2 rounded-lg transition">
          <i class="fas fa-sign-out-alt mr-1"></i> Đăng Xuất
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 py-8">
    
    <!-- Stats Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      
      <!-- Total Revenue -->
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
        <div class="text-xs font-semibold text-gray-500 mb-1">Tổng Doanh Thu</div>
        <div class="text-xl md:text-2xl font-black text-emerald-600"><%= formatCurrency(stats.totalRevenue) %></div>
        <div class="text-[10px] text-gray-400 mt-1">Tính trên đơn đã xác nhận / giao</div>
      </div>

      <!-- Priority Queue Count -->
      <div class="bg-gradient-to-br from-amber-500 to-orange-600 text-white p-5 rounded-2xl shadow-md">
        <div class="text-xs font-bold text-amber-100 mb-1 flex items-center gap-1">
          <i class="fas fa-bolt text-yellow-300"></i> ĐƠN CHUYỂN KHOẢN
        </div>
        <div class="text-2xl md:text-3xl font-black"><%= stats.priority %></div>
        <div class="text-[10px] text-amber-100 mt-1">Khách chọn CK - Check ngân hàng & đóng gói!</div>
      </div>

      <!-- Pending COD -->
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
        <div class="text-xs font-semibold text-gray-500 mb-1">Chờ Xác Nhận (COD)</div>
        <div class="text-xl md:text-2xl font-black text-blue-600"><%= stats.pending %></div>
        <div class="text-[10px] text-gray-400 mt-1">Gọi điện xác nhận đơn COD</div>
      </div>

      <!-- Total Orders -->
      <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
        <div class="text-xs font-semibold text-gray-500 mb-1">Tổng Đơn Hàng</div>
        <div class="text-xl md:text-2xl font-black text-gray-900"><%= stats.total %></div>
        <div class="text-[10px] text-gray-400 mt-1">Đơn đã giao: <%= stats.delivered %></div>
      </div>

    </div>

    <!-- Filter & Search Toolbar -->
    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-200 mb-6 flex flex-col md:flex-row gap-4 items-center justify-between">
      
      <!-- Status Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 text-xs font-semibold">
        <a href="/admin" class="px-3 py-2 rounded-xl transition <%= !statusFilter ? 'bg-orange-500 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
          Tất cả (<%= stats.total %>)
        </a>
        <a href="/admin?status=PRIORITY_QUEUE" class="px-3 py-2 rounded-xl transition flex items-center gap-1 <%= statusFilter === 'PRIORITY_QUEUE' ? 'bg-amber-500 text-white' : 'bg-amber-50 text-amber-800 hover:bg-amber-100' %>">
          ⚡ Ưu Tiên (<%= stats.priority %>)
        </a>
        <a href="/admin?status=PENDING" class="px-3 py-2 rounded-xl transition <%= statusFilter === 'PENDING' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
          Chờ COD (<%= stats.pending %>)
        </a>
        <a href="/admin?status=CONFIRMED" class="px-3 py-2 rounded-xl transition <%= statusFilter === 'CONFIRMED' ? 'bg-purple-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
          Đã xác nhận (<%= stats.confirmed %>)
        </a>
        <a href="/admin?status=SHIPPING" class="px-3 py-2 rounded-xl transition <%= statusFilter === 'SHIPPING' ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
          Đang giao (<%= stats.shipping %>)
        </a>
        <a href="/admin?status=DELIVERED" class="px-3 py-2 rounded-xl transition <%= statusFilter === 'DELIVERED' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
          Thành công (<%= stats.delivered %>)
        </a>
      </div>

      <!-- Search Box -->
      <form action="/admin" method="GET" class="w-full md:w-72 flex gap-2">
        <input type="hidden" name="status" value="<%= statusFilter %>">
        <input type="text" name="search" value="<%= search %>" placeholder="SĐT, Mã đơn, Tên..." class="w-full border border-gray-300 rounded-xl px-3 py-2 text-xs focus:ring-2 focus:ring-orange-500 outline-none">
        <button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded-xl text-xs font-bold hover:bg-gray-800 transition">
          <i class="fas fa-search"></i>
        </button>
      </form>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-gray-700">
          <thead class="bg-gray-50 border-b border-gray-200 font-bold text-gray-900 uppercase tracking-wider">
            <tr>
              <th class="py-3.5 px-4">Mã Đơn</th>
              <th class="py-3.5 px-4">Khách Hàng & SĐT</th>
              <th class="py-3.5 px-4">Địa Chỉ</th>
              <th class="py-3.5 px-4">Sản Phẩm</th>
              <th class="py-3.5 px-4">Thanh Toán</th>
              <th class="py-3.5 px-4">Tổng Tiền</th>
              <th class="py-3.5 px-4">Trạng Thái Xử Lý</th>
              <th class="py-3.5 px-4">Ngày Tạo</th>
              <th class="py-3.5 px-4 text-right">Chi Tiết</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if (orders.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center py-8 text-gray-400">Không có đơn hàng nào matching</td>
            </tr>
            <% } %>

            <% orders.forEach(order => { %>
            <tr class="hover:bg-gray-50/80 transition <%= order.is_priority && order.order_status === 'PRIORITY_QUEUE' ? 'bg-amber-50/60' : '' %>">
              
              <!-- Code -->
              <td class="py-3.5 px-4 font-black text-orange-600">
                <%= order.order_code %>
                <% if (order.is_priority) { %>
                <span class="block text-[9px] bg-amber-500 text-white px-1.5 py-0.5 rounded font-bold uppercase w-fit mt-1">⚡ ƯU TIÊN CK</span>
                <% } %>
              </td>

              <!-- Customer -->
              <td class="py-3.5 px-4">
                <div class="font-bold text-gray-900"><%= order.customer_name %></div>
                <div class="text-gray-500 font-mono"><%= order.customer_phone %></div>
              </td>

              <!-- Address -->
              <td class="py-3.5 px-4 max-w-xs truncate" title="<%= order.customer_address %>">
                <%= order.customer_address %>
                <% if (order.customer_note) { %>
                <div class="text-[10px] text-orange-600 italic">Note: <%= order.customer_note %></div>
                <% } %>
              </td>

              <!-- Items -->
              <td class="py-3.5 px-4">
                <% order.items.forEach(item => { %>
                <div class="truncate max-w-xs text-[11px] font-medium text-gray-800">
                  • <%= item.name %> <span class="font-bold text-orange-600">x<%= item.quantity %></span>
                </div>
                <% }) %>
              </td>

              <!-- Payment -->
              <td class="py-3.5 px-4">
                <span class="font-semibold text-gray-900">
                  <%= order.payment_method === 'BANK_TRANSFER' ? 'Chuyển Khoản' : 'COD' %>
                </span>
                <span class="block text-[10px] text-gray-400"><%= order.payment_status %></span>
              </td>

              <!-- Total -->
              <td class="py-3.5 px-4 font-black text-red-600 text-sm">
                <%= formatCurrency(order.total_amount) %>
              </td>

              <!-- Status Dropdown -->
              <td class="py-3.5 px-4">
                <form action="/admin/order/<%= order.id %>/status" method="POST" class="inline-block">
                  <select name="status" onchange="this.form.submit()" class="border border-gray-300 rounded-lg px-2.5 py-1.5 text-xs font-bold focus:ring-2 focus:ring-orange-500 outline-none bg-white cursor-pointer shadow-sm">
                    <option value="PRIORITY_QUEUE" <%= order.order_status === 'PRIORITY_QUEUE' ? 'selected' : '' %>>⚡ Chuyển Khoản (Check CK)</option>
                    <option value="PENDING" <%= order.order_status === 'PENDING' ? 'selected' : '' %>>⏳ Chờ Xác Nhận (COD)</option>
                    <option value="CONFIRMED" <%= order.order_status === 'CONFIRMED' ? 'selected' : '' %>>📦 Đã Đóng Gói</option>
                    <option value="SHIPPING" <%= order.order_status === 'SHIPPING' ? 'selected' : '' %>>🚚 Đang Giao Hàng</option>
                    <option value="DELIVERED" <%= order.order_status === 'DELIVERED' ? 'selected' : '' %>>✅ Giao Thành Công</option>
                    <option value="CANCELLED" <%= order.order_status === 'CANCELLED' ? 'selected' : '' %>>❌ Đã Hủy</option>
                  </select>
                </form>
              </td>

              <!-- Date -->
              <td class="py-3.5 px-4 text-gray-400 text-[11px]">
                <%= new Date(order.created_at).toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) %>
              </td>

              <!-- Detail -->
              <td class="py-3.5 px-4 text-right">
                <a href="/admin/order/<%= order.id %>" class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap bg-gray-900 hover:bg-orange-600 text-white font-bold px-3 py-2 rounded-lg text-xs transition">
                  <i class="fas fa-eye"></i>
                  Xem chi tiết
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
