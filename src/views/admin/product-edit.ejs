<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>* { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-100 min-h-screen">
  <!-- Top Admin Navbar -->
  <header class="bg-gray-900 text-white sticky top-0 z-30 shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <a href="/admin/products" class="text-xs bg-gray-800 hover:bg-gray-700 text-white font-bold px-3 py-2 rounded-lg transition flex items-center gap-1">
          <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <h1 class="text-base font-bold truncate max-w-md">Chỉnh Sửa: <%= product.name %></h1>
      </div>

      <div class="flex items-center gap-4">
        <a href="/product/<%= product.slug %>" target="_blank" class="text-xs bg-orange-600 hover:bg-orange-700 text-white font-semibold px-3 py-2 rounded-lg transition">
          <i class="fas fa-eye mr-1"></i> Xem Chi Tiết Trên Web
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 py-8">
    <% if (saved) { %>
    <div class="bg-emerald-500 text-white font-bold p-4 rounded-2xl mb-6 shadow-md flex items-center justify-between">
      <span><i class="fas fa-check-circle mr-2"></i> Đã lưu thông tin sản phẩm thành công!</span>
      <a href="/product/<%= product.slug %>" target="_blank" class="underline text-xs">Xem trang sản phẩm &rarr;</a>
    </div>
    <% } %>

    <form action="/admin/product/<%= product.id %>/edit" method="POST" class="space-y-8">
      
      <!-- General Information -->
      <div class="bg-white rounded-3xl p-6 lg:p-8 shadow-sm border border-gray-200">
        <h2 class="text-lg font-bold text-gray-900 mb-6 pb-2 border-b border-gray-100 flex items-center gap-2">
          <i class="fas fa-info-circle text-orange-500"></i> Thông Tin Cơ Bản
        </h2>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Tên sản phẩm</label>
            <input id="product-name-input" type="text" name="name" value="<%= product.name %>" required class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500 font-semibold" oninput="syncSlugFromName()">
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Slug (Đường dẫn URL)</label>
              <input id="product-slug-input" data-original-slug="<%= product.slug %>" type="text" name="slug" value="<%= product.slug %>" required class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500" placeholder="vd: gia-do-dien-thoai-oto">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Huy hiệu (Badge)</label>
              <input type="text" name="badge" value="<%= product.badge %>" placeholder="Bán Chạy Nhất, Giá Kho Direct..." class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500">
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Giá bán niêm yết (VNĐ)</label>
              <input type="number" name="original_price" value="<%= product.original_price %>" required class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500 font-bold">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Giá mua trực tiếp tại Shop (VNĐ)</label>
              <input type="number" name="sale_price" value="<%= product.sale_price %>" required class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500 font-extrabold text-red-600">
            </div>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Số sao</label>
              <input type="number" name="rating" value="<%= product.rating ?? 0 %>" min="0" max="5" step="0.1" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Số lượt đánh giá</label>
              <input type="number" name="rating_count" value="<%= product.rating_count ?? 0 %>" min="0" step="1" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Đã bán</label>
              <input type="number" name="sold_count" value="<%= product.sold_count ?? 0 %>" min="0" step="1" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Thứ tự ưu tiên</label>
              <input type="number" name="display_order" value="<%= product.display_order ?? 0 %>" min="0" step="1" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500">
              <p class="text-[10px] text-gray-400 mt-1">Số nhỏ hơn sẽ hiển thị trước.</p>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Mô tả ngắn (Summary)</label>
            <textarea name="summary" rows="2" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500"><%= product.summary %></textarea>
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 mb-1">Mô tả chi tiết sản phẩm (Hỗ trợ HTML)</label>
            <textarea name="description" rows="6" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500 font-mono text-xs"><%= product.description %></textarea>
          </div>
        </div>
      </div>

      <!-- Product Media (Images & Videos) -->
      <div class="bg-white rounded-3xl p-6 lg:p-8 shadow-sm border border-gray-200">
        <div class="flex items-center justify-between mb-6 pb-2 border-b border-gray-100">
          <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
            <i class="fas fa-photo-video text-purple-600"></i> Danh Sách Hình Ảnh & Video Sản Phẩm
          </h2>
          <a href="/admin/media" target="_blank" class="text-xs bg-purple-50 hover:bg-purple-100 text-purple-700 font-bold px-3 py-1.5 rounded-xl border border-purple-200 transition">
            <i class="fas fa-folder-open mr-1"></i> Mở Drive Media
          </a>
        </div>

        <div class="space-y-6">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-xs font-bold text-gray-700">Danh sách URL Hình Ảnh (Mỗi đường dẫn 1 dòng)</label>
              <button type="button" onclick="openMediaPicker('images_text', 'text')" class="bg-orange-100 hover:bg-orange-200 text-orange-700 font-bold text-xs px-3 py-1 rounded-xl transition flex items-center gap-1">
                <i class="fas fa-folder-open"></i> Chọn Từ Thư Viện Media
              </button>
            </div>
            <textarea id="images_text" name="images_text" rows="4" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500 font-mono text-xs"><%= product.images.join('\n') %></textarea>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-xs font-bold text-gray-700">Danh sách Video về sản phẩm (Format: Tiêu Đề | URL)</label>
              <button type="button" onclick="openMediaPicker('videos_text', 'video')" class="bg-purple-100 hover:bg-purple-200 text-purple-700 font-bold text-xs px-3 py-1 rounded-xl transition flex items-center gap-1">
                <i class="fas fa-folder-open"></i> Chọn Từ Thư Viện Media
              </button>
            </div>
            <textarea id="videos_text" name="videos_text" rows="4" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500 font-mono text-xs"><%= product.videos.map(v => `${v.title} | ${v.url}`).join('\n') %></textarea>
          </div>
        </div>
      </div>

      <!-- Highlights & Specifications -->
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200">
          <h2 class="text-base font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
            <i class="fas fa-list text-emerald-600"></i> Điểm Nổi Bật (Mỗi dòng 1 điểm)
          </h2>
          <textarea name="highlights_text" rows="6" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500 text-xs"><%= product.highlights.join('\n') %></textarea>
        </div>

        <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200">
          <h2 class="text-base font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
            <i class="fas fa-sliders-h text-blue-600"></i> Thông Số Kỹ Thuật (Key: Value)
          </h2>
          <textarea name="specs_text" rows="6" class="w-full border border-gray-300 rounded-xl p-3 text-sm focus:outline-none focus:border-orange-500 font-mono text-xs"><%= Object.entries(product.specifications).map(([k, v]) => `${k}: ${v}`).join('\n') %></textarea>
        </div>
      </div>

      <!-- Product Classification / Variants -->
      <div class="bg-white rounded-3xl p-6 lg:p-8 shadow-sm border border-gray-200">
        <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-100">
          <div>
            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
              <i class="fas fa-tags text-indigo-600"></i> Phân Loại Sản Phẩm (Variants / Options)
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">Tạo các phiên bản/màu sắc/dung lượng khác nhau cho sản phẩm (ví dụ: Bản Thẻ 64GB, Bản 128GB, Màu Đen...)</p>
          </div>
          <button type="button" onclick="addVariantRow()" class="bg-indigo-100 hover:bg-indigo-200 text-indigo-700 font-bold text-xs px-3.5 py-2 rounded-xl transition">
            + Thêm Phân Loại Mới
          </button>
        </div>

        <!-- Dynamic Variants Container -->
        <div id="variants-container" class="space-y-4 mb-6">
          <% (product.variants || []).forEach((v) => { %>
          <div class="variant-item bg-gray-50 p-4 rounded-2xl border border-gray-200 grid md:grid-cols-12 gap-3 items-center">
            <div class="md:col-span-4">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">Tên phân loại (Màu/Dung lượng/Combo)</label>
              <input type="text" class="var-name w-full border border-gray-300 rounded-lg p-2 text-xs font-bold" value="<%= v.name %>" placeholder="Bản Thẻ 64GB High-speed">
            </div>
            <div class="md:col-span-3">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">Giá bán trực tiếp (VNĐ)</label>
              <input type="number" class="var-price w-full border border-gray-300 rounded-lg p-2 text-xs font-extrabold text-red-600" value="<%= v.price %>" placeholder="790000">
            </div>
            <div class="md:col-span-2">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">Giá gốc niêm yết</label>
              <input type="number" class="var-original w-full border border-gray-300 rounded-lg p-2 text-xs font-semibold text-gray-400" value="<%= v.original_price || '' %>" placeholder="1390000">
            </div>
            <div class="md:col-span-2">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">URL Ảnh phân loại (tùy chọn)</label>
              <div class="flex items-center gap-1">
                <input type="text" class="var-image w-full border border-gray-300 rounded-lg p-2 text-xs font-mono" value="<%= v.image || '' %>" placeholder="/uploads/products/...">
                <button type="button" onclick="openMediaPicker(this.previousElementSibling, 'input')" class="p-2 text-xs bg-gray-100 hover:bg-gray-200 rounded-lg font-bold text-gray-700" title="Chọn từ Drive">
                  <i class="fas fa-folder-open"></i>
                </button>
              </div>
            </div>
            <div class="md:col-span-1 flex justify-end">
              <button type="button" onclick="removeVariantRow(this)" class="text-red-500 hover:text-red-700 p-2 text-sm" title="Xóa phân loại">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
          <% }) %>
        </div>

        <input type="hidden" name="variants_json" id="variants_json">
      </div>

      <!-- Customer Media / Video Reviews -->
      <div class="bg-white rounded-3xl p-6 lg:p-8 shadow-sm border border-gray-200">
        <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-100">
          <div>
            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
              <i class="fas fa-comments text-amber-500"></i> Đánh Giá Thực Tế Dạng Hình Ảnh / Video
            </h2>
            <p class="text-xs text-gray-500 mt-0.5">Admin có thể thêm đánh giá của khách kèm hình ảnh chụp thực tế hoặc link video review.</p>
          </div>
          <button type="button" onclick="addReviewRow()" class="bg-orange-100 hover:bg-orange-200 text-orange-700 font-bold text-xs px-3 py-2 rounded-xl transition">
            + Thêm Đánh Giá Mới
          </button>
        </div>

        <!-- Dynamic Reviews Container -->
        <div id="reviews-container" class="space-y-4 mb-6">
          <% product.reviews.forEach((r, idx) => { %>
          <div class="review-item bg-gray-50 p-4 rounded-2xl border border-gray-200 grid md:grid-cols-12 gap-3 items-center">
            <div class="md:col-span-3">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">Tên khách hàng</label>
              <input type="text" class="rev-name w-full border border-gray-300 rounded-lg p-2 text-xs" value="<%= r.name %>">
            </div>
            <div class="md:col-span-2">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">Số sao (1-5)</label>
              <input type="number" min="1" max="5" class="rev-rating w-full border border-gray-300 rounded-lg p-2 text-xs font-bold text-yellow-600" value="<%= r.rating %>">
            </div>
            <div class="md:col-span-2">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">Loại file đính kèm</label>
              <select class="rev-type w-full border border-gray-300 rounded-lg p-2 text-xs font-semibold">
                <option value="image" <%= r.type === 'image' ? 'selected' : '' %>>🖼️ Hình Ảnh</option>
                <option value="video" <%= r.type === 'video' ? 'selected' : '' %>>🎥 Video</option>
              </select>
            </div>
            <div class="md:col-span-4">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">URL Media (Ảnh/Video proof)</label>
              <input type="text" class="rev-url w-full border border-gray-300 rounded-lg p-2 text-xs font-mono" value="<%= r.media_url || '' %>">
            </div>
            <div class="md:col-span-1 flex justify-end">
              <button type="button" onclick="removeReviewRow(this)" class="text-red-500 hover:text-red-700 p-2 text-sm">
                <i class="fas fa-trash"></i>
              </button>
            </div>
            <div class="md:col-span-12">
              <label class="block text-[10px] text-gray-500 font-semibold mb-1">Nội dung đánh giá</label>
              <textarea class="rev-comment w-full border border-gray-300 rounded-lg p-2 text-xs" rows="2"><%= r.comment %></textarea>
            </div>
          </div>
          <% }) %>
        </div>

        <input type="hidden" name="reviews_json" id="reviews_json">
      </div>

      <!-- Save Button Footer -->
      <div class="sticky bottom-4 bg-gray-900/90 backdrop-blur text-white p-4 rounded-2xl shadow-xl flex items-center justify-between">
        <div class="text-xs text-gray-300 font-medium">Nhấn "Lưu Thay Đổi" để cập nhật trang landing page và sản phẩm.</div>
        <button type="submit" onclick="prepareSubmit()" class="gradient-cta text-white font-extrabold px-6 py-3 rounded-xl text-sm shadow-lg hover:opacity-95 transition flex items-center gap-2">
          <i class="fas fa-save"></i> LƯU THAY ĐỔI
        </button>
      </div>

    </form>
  </main>

  <script>
    function slugifyText(value) {
      return (value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 120);
    }

    function syncSlugFromName() {
      const nameInput = document.getElementById('product-name-input');
      const slugInput = document.getElementById('product-slug-input');
      if (!nameInput || !slugInput) return;

      const nameValue = (nameInput.value || '').trim();
      const currentSlug = (slugInput.value || '').trim();
      const originalSlug = (slugInput.dataset.originalSlug || '').trim();
      const autoGenerated = slugifyText(nameValue);

      if (!nameValue) return;
      if (!currentSlug || currentSlug === originalSlug || currentSlug === slugifyText(originalSlug) || currentSlug === slugifyText(nameValue)) {
        slugInput.value = autoGenerated;
      }
    }

    function addReviewRow() {
      const container = document.getElementById('reviews-container');
      const div = document.createElement('div');
      div.className = 'review-item bg-gray-50 p-4 rounded-2xl border border-gray-200 grid md:grid-cols-12 gap-3 items-center';
      div.innerHTML = `
        <div class="md:col-span-3">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">Tên khách hàng</label>
          <input type="text" class="rev-name w-full border border-gray-300 rounded-lg p-2 text-xs" placeholder="Anh Nam - Hà Nội">
        </div>
        <div class="md:col-span-2">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">Số sao (1-5)</label>
          <input type="number" min="1" max="5" class="rev-rating w-full border border-gray-300 rounded-lg p-2 text-xs font-bold text-yellow-600" value="5">
        </div>
        <div class="md:col-span-2">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">Loại file đính kèm</label>
          <select class="rev-type w-full border border-gray-300 rounded-lg p-2 text-xs font-semibold">
            <option value="image">🖼️ Hình Ảnh</option>
            <option value="video">🎥 Video</option>
          </select>
        </div>
        <div class="md:col-span-4">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">URL Media (Ảnh/Video proof)</label>
          <input type="text" class="rev-url w-full border border-gray-300 rounded-lg p-2 text-xs font-mono" placeholder="https://... hoặc /images/...">
        </div>
        <div class="md:col-span-1 flex justify-end">
          <button type="button" onclick="removeReviewRow(this)" class="text-red-500 hover:text-red-700 p-2 text-sm">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        <div class="md:col-span-12">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">Nội dung đánh giá</label>
          <textarea class="rev-comment w-full border border-gray-300 rounded-lg p-2 text-xs" rows="2" placeholder="Sản phẩm rất tốt..."></textarea>
        </div>
      `;
      container.appendChild(div);
    }

    function removeReviewRow(btn) {
      btn.closest('.review-item').remove();
    }

    function addVariantRow() {
      const container = document.getElementById('variants-container');
      const div = document.createElement('div');
      div.className = 'variant-item bg-gray-50 p-4 rounded-2xl border border-gray-200 grid md:grid-cols-12 gap-3 items-center';
      div.innerHTML = `
        <div class="md:col-span-4">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">Tên phân loại (Màu/Dung lượng/Combo)</label>
          <input type="text" class="var-name w-full border border-gray-300 rounded-lg p-2 text-xs font-bold" placeholder="Phân loại mới (vd: Bản Kèm Thẻ 64GB)">
        </div>
        <div class="md:col-span-3">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">Giá bán trực tiếp (VNĐ)</label>
          <input type="number" class="var-price w-full border border-gray-300 rounded-lg p-2 text-xs font-extrabold text-red-600" placeholder="790000">
        </div>
        <div class="md:col-span-2">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">Giá gốc niêm yết</label>
          <input type="number" class="var-original w-full border border-gray-300 rounded-lg p-2 text-xs font-semibold text-gray-400" placeholder="1290000">
        </div>
        <div class="md:col-span-2">
          <label class="block text-[10px] text-gray-500 font-semibold mb-1">URL Ảnh phân loại (tùy chọn)</label>
          <input type="text" class="var-image w-full border border-gray-300 rounded-lg p-2 text-xs font-mono" placeholder="/images/...">
        </div>
        <div class="md:col-span-1 flex justify-end">
          <button type="button" onclick="removeVariantRow(this)" class="text-red-500 hover:text-red-700 p-2 text-sm" title="Xóa phân loại">
            <i class="fas fa-trash"></i>
          </button>
        </div>
      `;
      container.appendChild(div);
    }

    function removeVariantRow(btn) {
      btn.closest('.variant-item').remove();
    }

    function prepareSubmit() {
      const items = document.querySelectorAll('.review-item');
      const reviews = [];
      items.forEach(item => {
        const name = item.querySelector('.rev-name').value;
        const rating = parseInt(item.querySelector('.rev-rating').value) || 5;
        const type = item.querySelector('.rev-type').value;
        const media_url = item.querySelector('.rev-url').value;
        const comment = item.querySelector('.rev-comment').value;
        const date = new Date().toISOString().split('T')[0];
        if (name && comment) {
          reviews.push({ name, rating, type, media_url, comment, date });
        }
      });
      document.getElementById('reviews_json').value = JSON.stringify(reviews);

      const varItems = document.querySelectorAll('.variant-item');
      const variants = [];
      varItems.forEach(item => {
        const name = item.querySelector('.var-name').value;
        const price = parseInt(item.querySelector('.var-price').value) || 0;
        const original_price = parseInt(item.querySelector('.var-original').value) || 0;
        const image = item.querySelector('.var-image').value;
        if (name && price) {
          variants.push({ name, price, original_price, image });
        }
      });
      document.getElementById('variants_json').value = JSON.stringify(variants);
    }
  </script>
  <%- include('../partials/media-picker') %>
</body>
</html>
