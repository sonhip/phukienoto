<!-- PRODUCT LISTINGS SECTION -->
<section id="products" class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <span class="text-orange-600 text-sm font-bold uppercase tracking-widest">DANH SÁCH PHỤ KIỆN</span>
        <h2 class="text-3xl font-extrabold text-gray-900 mt-1">SẢN PHẨM PHỤ KIỆN Ô TÔ HOT</h2>
      </div>
      <div class="flex items-center gap-2 text-sm text-gray-600 bg-white px-4 py-2 rounded-xl shadow-sm border border-gray-200">
        <i class="fas fa-shield-alt text-emerald-500"></i> Cam kết 100% chính hãng - Đổi trả 30 ngày
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% products.forEach(product => { %>
      <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm card-hover flex flex-col justify-between">
        <a href="/product/<%= product.slug %>" class="block flex-1">
          <!-- Product Image -->
          <div class="relative bg-gray-100 aspect-square overflow-hidden group">
            <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
            <% if (product.badge) { %>
            <div class="absolute top-3 left-3 bg-gradient-to-r from-orange-500 to-red-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow">
              <%= product.badge %>
            </div>
            <% } %>
            <div class="absolute bottom-3 right-3 bg-black/60 text-white text-xs px-2.5 py-1 rounded-lg backdrop-blur-sm flex items-center gap-1">
              <i class="fas fa-star text-yellow-400"></i> <%= product.rating %> (<%= product.rating_count %>)
            </div>
            <div class="absolute bottom-3 left-3 bg-indigo-600 text-white text-xs px-2.5 py-1 rounded-lg flex items-center gap-1">
              <i class="fas fa-truck"></i> Miễn phí ship
            </div>
          </div>

          <!-- Content -->
          <div class="p-5">
            <h3 class="font-bold text-gray-900 text-base mb-2 line-clamp-2 hover:text-orange-600 transition">
              <%= product.name %>
            </h3>
            <p class="text-gray-500 text-xs mb-4 line-clamp-2"><%= product.summary %></p>

            <!-- Highlights -->
            <% if (product.highlights && product.highlights.length > 0) { %>
            <ul class="text-xs text-gray-600 space-y-1 mb-4">
              <% product.highlights.slice(0, 3).forEach(h => { %>
              <li class="flex items-center gap-1.5">
                <i class="fas fa-check text-emerald-500 text-[10px]"></i> <%= h %>
              </li>
              <% }) %>
            </ul>
            <% } %>

            <!-- Pricing -->
            <div class="flex items-baseline justify-between pt-2 border-t border-gray-100">
              <div>
                <span class="text-xl font-black text-red-600"><%= formatCurrency(product.sale_price) %></span>
                <span class="text-xs text-gray-400 price-slash ml-1.5"><%= formatCurrency(product.original_price) %></span>
              </div>
              <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">
                -<%= Math.round((1 - product.sale_price / product.original_price) * 100) %>%
              </span>
            </div>
          </div>
        </a>

        <!-- Buttons -->
        <div class="p-5 pt-0 grid grid-cols-2 gap-2">
          <button onclick="addToCart(<%= product.id %>)" class="bg-orange-50 text-orange-600 hover:bg-orange-100 font-semibold py-2.5 rounded-xl text-xs transition flex items-center justify-center gap-1">
            <i class="fas fa-cart-plus"></i> Thêm Giỏ Hàng
          </button>
          <button onclick="buyNow(<%= product.id %>)" class="gradient-cta text-white font-bold py-2.5 rounded-xl text-xs shadow hover:opacity-95 transition flex items-center justify-center gap-1">
            <i class="fas fa-bolt"></i> MUA NGAY
          </button>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

