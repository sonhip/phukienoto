<%- include('../partials/header') %>

<div class="bg-gray-50 py-10 min-h-screen">
  <div class="max-w-5xl mx-auto px-4">
    <h1 class="text-2xl font-black text-gray-900 mb-6 flex items-center gap-2">
      <i class="fas fa-shopping-cart text-orange-500"></i> Giỏ Hàng Của Bạn
    </h1>

    <% if (cart.length === 0) { %>
    <div class="bg-white rounded-3xl p-12 text-center shadow-sm border border-gray-200">
      <div class="w-20 h-20 bg-orange-100 text-orange-500 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
        <i class="fas fa-shopping-basket"></i>
      </div>
      <h2 class="text-xl font-bold text-gray-800 mb-2">Giỏ hàng đang trống!</h2>
      <p class="text-gray-500 text-sm mb-6">Hãy chọn các sản phẩm phụ kiện ô tô chất lượng từ cửa hàng.</p>
      <a href="/" class="gradient-cta text-white font-bold px-8 py-3 rounded-xl shadow inline-flex items-center gap-2">
        <i class="fas fa-arrow-left"></i> Khám Phá Sản Phẩm
      </a>
    </div>
    <% } else { %>

    <div class="grid md:grid-cols-3 gap-8">
      
      <!-- Cart Items List -->
      <div class="md:col-span-2 space-y-4">
        <% cart.forEach(item => { %>
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-200 flex items-center gap-4">
          <img src="<%= item.image %>" alt="<%= item.name %>" class="w-20 h-20 object-cover rounded-xl bg-gray-100 flex-shrink-0">
          <div class="flex-1">
            <h3 class="font-bold text-gray-900 text-sm mb-1"><%= item.name %></h3>
            <div class="text-red-600 font-extrabold text-sm"><%= formatCurrency(item.price) %></div>
            <div class="flex items-center gap-4 mt-2">
              <form action="/cart/update" method="POST" class="flex items-center border border-gray-300 rounded-lg overflow-hidden bg-gray-50">
                <input type="hidden" name="productId" value="<%= item.product_id %>">
                <button type="submit" name="quantity" value="<%= item.quantity - 1 %>" class="px-2 py-1 text-gray-600 hover:bg-gray-200 font-bold">-</button>
                <span class="px-3 text-xs font-bold text-gray-800"><%= item.quantity %></span>
                <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="px-2 py-1 text-gray-600 hover:bg-gray-200 font-bold">+</button>
              </form>
              <form action="/cart/remove" method="POST">
                <input type="hidden" name="productId" value="<%= item.product_id %>">
                <button type="submit" class="text-xs text-red-500 hover:text-red-700 font-medium flex items-center gap-1">
                  <i class="fas fa-trash-alt"></i> Xóa
                </button>
              </form>
            </div>
          </div>
          <div class="text-right font-bold text-gray-900 text-sm">
            <%= formatCurrency(item.price * item.quantity) %>
          </div>
        </div>
        <% }) %>
      </div>

      <!-- Order Summary -->
      <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 h-fit space-y-6">
        <h2 class="font-bold text-gray-900 text-lg pb-3 border-b border-gray-100">Tóm Tắt Đơn Hàng</h2>
        
        <div class="space-y-3 text-sm">
          <div class="flex justify-between text-gray-600">
            <span>Tạm tính:</span>
            <span class="font-semibold text-gray-900"><%= formatCurrency(total) %></span>
          </div>
          <div class="flex justify-between text-gray-600">
            <span>Phí vận chuyển:</span>
            <span class="font-bold text-emerald-600">MIỄN PHÍ</span>
          </div>
          <div class="border-t border-gray-100 pt-3 flex justify-between items-baseline">
            <span class="font-bold text-gray-900">Tổng thanh toán:</span>
            <span class="text-2xl font-black text-red-600"><%= formatCurrency(total) %></span>
          </div>
        </div>

        <div class="bg-amber-50 border border-amber-200 p-3.5 rounded-2xl text-xs text-amber-800">
          <i class="fas fa-bolt text-amber-500 mr-1"></i> Mẹo nhỏ: Chọn <strong>Chuyển Khoản Ngân Hàng</strong> để đơn hàng được hệ thống tự động duyệt 24/7 ngay tức thì!
        </div>

        <a href="/order/checkout" class="w-full gradient-cta text-white font-extrabold py-4 rounded-2xl text-center shadow-lg hover:opacity-95 transition flex items-center justify-center gap-2">
          TIẾN HÀNH THANH TOÁN <i class="fas fa-arrow-right"></i>
        </a>
      </div>

    </div>

    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
