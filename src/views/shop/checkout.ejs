<%- include('../partials/header') %>

<div class="bg-gray-50 py-10 min-h-screen">
  <div class="max-w-5xl mx-auto px-4">
    <h1 class="text-2xl font-black text-gray-900 mb-6 flex items-center gap-2">
      <i class="fas fa-credit-card text-orange-500"></i> Thanh Toán Đơn Hàng
    </h1>

    <form action="/order/submit" method="POST" id="checkout-form">
      <div class="grid md:grid-cols-3 gap-8">
        
        <!-- Customer Info Form -->
        <div class="md:col-span-2 space-y-6">
          
          <!-- Shipping Info -->
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200">
            <h2 class="font-bold text-gray-900 text-lg mb-5 flex items-center gap-2">
              <i class="fas fa-map-marker-alt text-orange-500"></i> Thông Tin Giao Hàng
            </h2>
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Họ và Tên <span class="text-red-500">*</span></label>
                <input type="text" name="customer_name" required placeholder="Nguyễn Văn A" class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1.5 flex items-center justify-between">
                  <span>Số Điện Thoại <span class="text-red-500">*</span></span>
                  <span id="phone-val-status" class="text-[11px] font-semibold text-gray-400">Định dạng chuẩn: 10 chữ số</span>
                </label>
                <div class="relative">
                  <input 
                    type="tel" 
                    name="customer_phone" 
                    id="customer_phone"
                    required 
                    maxlength="11"
                    pattern="^(0|\+84)(3|5|7|8|9)[0-9]{8}$"
                    placeholder="Ví dụ: 0838709126 hoặc 0912345678" 
                    oninput="validatePhoneRealtime(this)"
                    class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition font-semibold"
                  >
                  <span id="phone-icon-check" class="absolute right-3.5 top-1/2 -translate-y-1/2 hidden text-emerald-500 text-base">
                    <i class="fas fa-check-circle"></i>
                  </span>
                </div>
                <p id="phone-err-msg" class="text-[11px] text-red-500 mt-1 hidden flex items-center gap-1">
                  <i class="fas fa-exclamation-circle"></i> Số điện thoại phải gồm 10 chữ số (bắt đầu bằng 03, 05, 07, 08, 09 - vd: 0838709126)
                </p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1.5 flex items-center justify-between">
                  <span>Địa Chỉ Giao Hàng <span class="text-red-500">*</span></span>
                  <span class="text-[11px] text-orange-600 font-medium">Hỗ trợ địa chỉ sáp nhập hành chính</span>
                </label>

                <!-- Address Type Selector Tabs -->
                <div class="flex items-center gap-2 p-1 bg-gray-100 rounded-xl mb-2.5">
                  <button 
                    type="button" 
                    id="tab-addr-new"
                    onclick="switchAddrTab('new')" 
                    class="flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 bg-white text-orange-600 shadow-sm border border-gray-200"
                  >
                    <i class="fas fa-city text-xs"></i> Địa chỉ mới (Sau sáp nhập)
                  </button>
                  <button 
                    type="button" 
                    id="tab-addr-old"
                    onclick="switchAddrTab('old')" 
                    class="flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 text-gray-500 hover:text-gray-700"
                  >
                    <i class="fas fa-history text-xs"></i> Địa chỉ cũ
                  </button>
                </div>

                <input type="hidden" name="address_type" id="address_type" value="NEW">

                <textarea 
                  name="customer_address" 
                  id="customer_address"
                  required 
                  rows="2.5" 
                  placeholder="Nhập số nhà, tên đường, Phường/Xã mới (sau sáp nhập), Quận/Huyện, Tỉnh/Thành phố..." 
                  class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition resize-none"
                ></textarea>

                <p id="addr-tab-hint" class="text-[11px] text-gray-500 mt-1 italic">
                  💡 Bạn đang chọn nhập theo <strong class="text-orange-600">Địa chỉ đơn vị hành chính mới (Sau sáp nhập)</strong>.
                </p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Ghi Chú (Tùy chọn)</label>
                <input type="text" name="customer_note" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao..." class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition">
              </div>
            </div>
          </div>

          <!-- Payment Method -->
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200">
            <h2 class="font-bold text-gray-900 text-lg mb-5 flex items-center gap-2">
              <i class="fas fa-wallet text-orange-500"></i> Phương Thức Thanh Toán
            </h2>
            <div class="space-y-3">
              <!-- Bank Transfer -->
              <label class="flex items-start gap-4 p-4 border-2 border-amber-400 bg-amber-50 rounded-2xl cursor-pointer hover:bg-amber-100 transition relative">
                <input type="radio" name="payment_method" value="BANK_TRANSFER" checked class="mt-1 accent-orange-600">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-bold text-gray-900 text-sm">Chuyển Khoản Ngân Hàng (QR Code)</span>
                    <span class="bg-amber-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">DUYỆT TỰ ĐỘNG 24/7</span>
                  </div>
                  <p class="text-xs text-gray-600">Hệ thống tự động xác nhận đơn ngay lập tức 24/7, đóng gói bàn giao shipper nhanh chóng mà không cần chờ duyệt thủ công.</p>
                </div>
                <i class="fas fa-bolt text-amber-500 text-xl"></i>
              </label>

              <!-- COD -->
              <label class="flex items-start gap-4 p-4 border-2 border-gray-200 rounded-2xl cursor-pointer hover:bg-gray-50 transition">
                <input type="radio" name="payment_method" value="COD" class="mt-1 accent-orange-600">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-bold text-gray-900 text-sm">Thanh Toán Khi Nhận Hàng (COD)</span>
                  </div>
                  <p class="text-xs text-gray-600">Shop gọi điện xác nhận nhanh trong ngày. Được mở hộp kiểm tra sản phẩm ưng ý mới thanh toán.</p>
                </div>
                <i class="fas fa-box-open text-gray-400 text-xl"></i>
              </label>
            </div>
          </div>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="space-y-6">
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-200 sticky top-20">
            <h2 class="font-bold text-gray-900 text-lg mb-4 pb-3 border-b border-gray-100">Đơn Hàng Của Bạn</h2>
            
            <div class="space-y-3 mb-4">
              <% cart.forEach(item => { %>
              <div class="flex items-center gap-3">
                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-12 h-12 rounded-lg object-cover bg-gray-100">
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-semibold text-gray-900 truncate"><%= item.name %></p>
                  <p class="text-xs text-gray-500">x<%= item.quantity %></p>
                </div>
                <span class="text-xs font-bold text-gray-900"><%= formatCurrency(item.price * item.quantity) %></span>
              </div>
              <% }) %>
            </div>

            <div class="border-t border-gray-100 pt-4 space-y-2 text-sm">
              <div class="flex justify-between text-gray-600">
                <span>Tạm tính:</span>
                <span class="font-semibold"><%= formatCurrency(total) %></span>
              </div>
              <div class="flex justify-between text-gray-600">
                <span>Phí vận chuyển:</span>
                <span class="font-bold text-emerald-600">MIỄN PHÍ</span>
              </div>
              <div class="border-t border-gray-100 pt-3 flex justify-between items-baseline">
                <span class="font-bold text-gray-900">Tổng:</span>
                <span class="text-2xl font-black text-red-600"><%= formatCurrency(total) %></span>
              </div>
            </div>

            <button type="submit" class="w-full gradient-cta text-white font-extrabold py-4 rounded-2xl text-center shadow-lg hover:opacity-95 transition mt-6 flex items-center justify-center gap-2 text-sm">
              <i class="fas fa-lock"></i> ĐẶT HÀNG NGAY
            </button>

            <div class="flex items-center justify-center gap-4 mt-4 text-[10px] text-gray-400">
              <span><i class="fas fa-shield-alt mr-1"></i> Bảo mật</span>
              <span><i class="fas fa-undo mr-1"></i> Đổi trả 30 ngày</span>
              <span><i class="fas fa-truck mr-1"></i> Giao toàn quốc</span>
            </div>
          </div>
        </div>

      </div>
    </form>
  </div>
</div>

<script>
  function validatePhoneRealtime(input) {
    let val = input.value.replace(/[^\d+]/g, '');
    if (val.startsWith('+84')) {
      val = '0' + val.substring(3);
    }
    input.value = val;

    const statusEl = document.getElementById('phone-val-status');
    const iconEl = document.getElementById('phone-icon-check');
    const errEl = document.getElementById('phone-err-msg');
    const vnPhoneRegex = /^0(3|5|7|8|9)[0-9]{8}$/;

    if (!val) {
      if (statusEl) { statusEl.textContent = 'Định dạng chuẩn: 10 chữ số'; statusEl.className = 'text-[11px] font-semibold text-gray-400'; }
      if (iconEl) iconEl.classList.add('hidden');
      if (errEl) errEl.classList.add('hidden');
      input.classList.remove('border-red-500', 'border-emerald-500', 'focus:ring-red-500');
      return false;
    }

    if (vnPhoneRegex.test(val)) {
      if (statusEl) { statusEl.textContent = '✓ Số điện thoại hợp lệ'; statusEl.className = 'text-[11px] font-bold text-emerald-600'; }
      if (iconEl) iconEl.classList.remove('hidden');
      if (errEl) errEl.classList.add('hidden');
      input.classList.remove('border-red-500', 'focus:ring-red-500');
      input.classList.add('border-emerald-500');
      return true;
    } else {
      if (statusEl) { statusEl.textContent = '⚠️ Chưa đúng định dạng'; statusEl.className = 'text-[11px] font-bold text-red-500'; }
      if (iconEl) iconEl.classList.add('hidden');
      if (errEl && val.length >= 10) errEl.classList.remove('hidden');
      else if (errEl) errEl.classList.add('hidden');
      input.classList.remove('border-emerald-500');
      input.classList.add('border-red-500', 'focus:ring-red-500');
      return false;
    }
  }

  document.getElementById('checkout-form')?.addEventListener('submit', function(e) {
    const phoneInput = document.getElementById('customer_phone');
    if (phoneInput && !validatePhoneRealtime(phoneInput)) {
      e.preventDefault();
      alert('Vui lòng nhập số điện thoại hợp lệ gồm 10 chữ số (bắt đầu bằng 03, 05, 07, 08, 09 - ví dụ: 0838709126) trước khi đặt hàng!');
      phoneInput.focus();
    }
  });

  function switchAddrTab(type) {
    const tabNew = document.getElementById('tab-addr-new');
    const tabOld = document.getElementById('tab-addr-old');
    const typeInput = document.getElementById('address_type');
    const addrInput = document.getElementById('customer_address');
    const hint = document.getElementById('addr-tab-hint');

    if (type === 'new') {
      typeInput.value = 'NEW';
      tabNew.className = 'flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 bg-white text-orange-600 shadow-sm border border-gray-200';
      tabOld.className = 'flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 text-gray-500 hover:text-gray-700';
      addrInput.placeholder = 'Nhập số nhà, tên đường, Phường/Xã mới (sau sáp nhập), Quận/Huyện, Tỉnh/Thành phố...';
      if (hint) hint.innerHTML = '💡 Bạn đang chọn nhập theo <strong class="text-orange-600">Địa chỉ đơn vị hành chính mới (Sau sáp nhập)</strong>.';
    } else {
      typeInput.value = 'OLD';
      tabOld.className = 'flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 bg-white text-orange-600 shadow-sm border border-gray-200';
      tabNew.className = 'flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 text-gray-500 hover:text-gray-700';
      addrInput.placeholder = 'Nhập số nhà, tên đường, Xã/Phường cũ, Huyện/Quận cũ, Tỉnh/Thành phố cũ...';
      if (hint) hint.innerHTML = '💡 Bạn đang chọn nhập theo <strong class="text-orange-600">Địa chỉ đơn vị hành chính cũ</strong> (Shop sẽ hỗ trợ đối soát địa chỉ giao đến tận nơi).';
    }
  }
</script>

<%- include('../partials/footer') %>
