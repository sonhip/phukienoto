<%- include('../partials/header') %>

<style>
  @media (max-width: 640px) {
    .floating-contact-buttons {
      opacity: 0.35;
      transition: opacity 0.2s ease;
    }
    .floating-contact-buttons:hover,
    .floating-contact-buttons:active {
      opacity: 1;
    }
  }
</style>

<div class="bg-gray-50 py-4 sm:py-10 min-h-screen overflow-x-hidden max-w-full">
  <div class="max-w-5xl mx-auto px-3 sm:px-4 w-full min-w-0">
    <h1 class="text-xl sm:text-2xl font-black text-gray-900 mb-4 sm:mb-6 flex items-center gap-2">
      <i class="fas fa-credit-card text-orange-500"></i> Thanh Toán Đơn Hàng
    </h1>

    <form action="/order/submit" method="POST" id="checkout-form" class="w-full min-w-0">
      <div class="grid md:grid-cols-3 gap-5 md:gap-8 w-full min-w-0">
        
        <!-- Customer Info Form -->
        <div class="md:col-span-2 space-y-4 sm:space-y-6 w-full min-w-0">
          
          <!-- Shipping Info -->
          <div class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-6 shadow-sm border border-gray-200 w-full min-w-0 overflow-hidden">
            <h2 class="font-bold text-gray-900 text-base sm:text-lg mb-4 sm:mb-5 flex items-center gap-2">
              <i class="fas fa-map-marker-alt text-orange-500"></i> Thông Tin Giao Hàng
            </h2>
            <div class="space-y-3.5 sm:space-y-4 w-full min-w-0">
              <div class="w-full min-w-0">
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Họ và Tên <span class="text-red-500">*</span></label>
                <input type="text" name="customer_name" required placeholder="Nguyễn Văn A" class="w-full border border-gray-300 rounded-xl px-3.5 sm:px-4 py-2.5 sm:py-3 text-xs sm:text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition">
              </div>
              <div class="w-full min-w-0">
                <label class="block text-xs font-semibold text-gray-700 mb-1.5 flex items-center justify-between flex-wrap gap-1">
                  <span>Số Điện Thoại <span class="text-red-500">*</span></span>
                  <span id="phone-val-status" class="text-[10px] sm:text-[11px] font-semibold text-gray-400">Định dạng chuẩn: 10 chữ số</span>
                </label>
                <div class="relative w-full min-w-0">
                  <input 
                    type="tel" 
                    name="customer_phone" 
                    id="customer_phone"
                    required 
                    maxlength="11"
                    pattern="^(0|\+84)(3|5|7|8|9)[0-9]{8}$"
                    placeholder="Ví dụ: 0838709126 hoặc 0912345678" 
                    oninput="validatePhoneRealtime(this)"
                    class="w-full border border-gray-300 rounded-xl px-3.5 sm:px-4 py-2.5 sm:py-3 text-xs sm:text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition font-semibold"
                  >
                  <span id="phone-icon-check" class="absolute right-3.5 top-1/2 -translate-y-1/2 hidden text-emerald-500 text-base">
                    <i class="fas fa-check-circle"></i>
                  </span>
                </div>
                <p id="phone-err-msg" class="text-[10px] sm:text-[11px] text-red-500 mt-1 hidden flex items-center gap-1">
                  <i class="fas fa-exclamation-circle"></i> Số điện thoại phải gồm 10 chữ số (bắt đầu bằng 03, 05, 07, 08, 09 - vd: 0838709126)
                </p>
              </div>
              <div class="w-full min-w-0">
                <label class="block text-xs font-semibold text-gray-700 mb-1.5 flex items-center justify-between flex-wrap gap-1">
                  <span>Địa Chỉ Giao Hàng <span class="text-red-500">*</span></span>
                  <span class="text-[10px] sm:text-[11px] text-orange-600 font-medium">Hỗ trợ địa chỉ sáp nhập hành chính</span>
                </label>

                <!-- Address Type Selector Tabs -->
                <div class="grid grid-cols-2 gap-1.5 p-1 bg-gray-100 rounded-xl mb-2.5 w-full min-w-0">
                  <button 
                    type="button" 
                    id="tab-addr-new"
                    onclick="switchAddrTab('new')" 
                    class="py-2 px-1.5 sm:px-3 rounded-lg text-[10px] sm:text-xs font-bold transition flex items-center justify-center gap-1 text-center bg-white text-orange-600 shadow-sm border border-gray-200 min-w-0"
                  >
                    <i class="fas fa-city text-xs flex-shrink-0"></i> <span class="truncate">Mới (Sau sáp nhập)</span>
                  </button>
                  <button 
                    type="button" 
                    id="tab-addr-old"
                    onclick="switchAddrTab('old')" 
                    class="py-2 px-1.5 sm:px-3 rounded-lg text-[10px] sm:text-xs font-bold transition flex items-center justify-center gap-1 text-center text-gray-500 hover:text-gray-700 min-w-0"
                  >
                    <i class="fas fa-history text-xs flex-shrink-0"></i> <span class="truncate">Địa chỉ cũ</span>
                  </button>
                </div>

                <input type="hidden" name="address_type" id="address_type" value="NEW">

                <textarea 
                  name="customer_address" 
                  id="customer_address"
                  required 
                  rows="2.5" 
                  placeholder="Nhập số nhà, tên đường, Phường/Xã mới (sau sáp nhập), Quận/Huyện, Tỉnh/Thành phố..." 
                  class="w-full border border-gray-300 rounded-xl px-3.5 sm:px-4 py-2.5 sm:py-3 text-xs sm:text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition resize-none"
                ></textarea>

                <p id="addr-tab-hint" class="text-[10px] sm:text-[11px] text-gray-500 mt-1 italic leading-tight">
                  💡 Bạn đang chọn nhập theo <strong class="text-orange-600">Địa chỉ đơn vị hành chính mới (Sau sáp nhập)</strong>.
                </p>
              </div>
              <div class="w-full min-w-0">
                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Ghi Chú (Tùy chọn)</label>
                <input type="text" name="customer_note" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao..." class="w-full border border-gray-300 rounded-xl px-3.5 sm:px-4 py-2.5 sm:py-3 text-xs sm:text-sm focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition">
              </div>
            </div>
          </div>

          <!-- Payment Method -->
          <div class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-6 shadow-sm border border-gray-200 w-full min-w-0 overflow-hidden">
            <h2 class="font-bold text-gray-900 text-base sm:text-lg mb-4 sm:mb-5 flex items-center gap-2">
              <i class="fas fa-wallet text-orange-500"></i> Phương Thức Thanh Toán
            </h2>
            <div class="space-y-3 w-full min-w-0">
              <!-- Bank Transfer -->
              <label class="flex items-start gap-2.5 sm:gap-4 p-3 sm:p-4 border-2 border-amber-400 bg-amber-50 rounded-2xl cursor-pointer hover:bg-amber-100 transition relative min-w-0">
                <input type="radio" name="payment_method" value="BANK_TRANSFER" checked class="mt-1 accent-orange-600 flex-shrink-0">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5 flex-wrap mb-1">
                    <span class="font-bold text-gray-900 text-xs sm:text-sm">Chuyển Khoản Ngân Hàng (QR Code)</span>
                    <span class="bg-amber-500 text-white text-[9px] sm:text-[10px] font-extrabold px-1.5 py-0.5 rounded-full uppercase flex-shrink-0">DUYỆT TỰ ĐỘNG 24/7</span>
                  </div>
                  <p class="text-[11px] sm:text-xs text-gray-600 leading-relaxed">Hệ thống tự động xác nhận đơn ngay lập tức 24/7, đóng gói bàn giao shipper nhanh chóng mà không cần chờ duyệt thủ công.</p>
                </div>
                <i class="fas fa-bolt text-amber-500 text-base sm:text-xl flex-shrink-0 hidden sm:block"></i>
              </label>

              <!-- COD -->
              <label class="flex items-start gap-2.5 sm:gap-4 p-3 sm:p-4 border-2 border-gray-200 rounded-2xl cursor-pointer hover:bg-gray-50 transition relative min-w-0">
                <input type="radio" name="payment_method" value="COD" class="mt-1 accent-orange-600 flex-shrink-0">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5 flex-wrap mb-1">
                    <span class="font-bold text-gray-900 text-xs sm:text-sm">Thanh Toán Khi Nhận Hàng (COD)</span>
                  </div>
                  <p class="text-[11px] sm:text-xs text-gray-600 leading-relaxed">Shop gọi điện xác nhận nhanh trong ngày. Được mở hộp kiểm tra sản phẩm ưng ý mới thanh toán.</p>
                </div>
                <i class="fas fa-box-open text-gray-400 text-base sm:text-xl flex-shrink-0 hidden sm:block"></i>
              </label>
            </div>
          </div>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="space-y-6 w-full min-w-0">
          <div class="bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-6 shadow-sm border border-gray-200 sticky top-20 w-full min-w-0">
            <h2 class="font-bold text-gray-900 text-base sm:text-lg mb-4 pb-3 border-b border-gray-100 flex items-center gap-2">
              <i class="fas fa-receipt text-orange-500"></i> Đơn Hàng Của Bạn
            </h2>
            
            <div class="space-y-3 mb-4">
              <% cart.forEach(item => { %>
              <div class="flex items-center gap-3">
                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-12 h-12 rounded-lg object-cover bg-gray-100 flex-shrink-0">
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-semibold text-gray-900 truncate"><%= item.name %></p>
                  <p class="text-xs text-gray-500">x<%= item.quantity %></p>
                </div>
                <span class="text-xs font-bold text-gray-900 flex-shrink-0"><%= formatCurrency(item.price * item.quantity) %></span>
              </div>
              <% }) %>
            </div>

            <div class="border-t border-gray-100 pt-4 space-y-2 text-xs sm:text-sm">
              <div class="flex justify-between text-gray-600">
                <span>Tạm tính:</span>
                <span class="font-semibold"><%= formatCurrency(total) %></span>
              </div>
              <div class="flex justify-between text-gray-600">
                <span>Phí vận chuyển:</span>
                <span class="font-bold text-emerald-600">MIỄN PHÍ</span>
              </div>
              <div class="border-t border-gray-100 pt-3 flex justify-between items-baseline">
                <span class="font-bold text-gray-900 text-sm">Tổng:</span>
                <span class="text-xl sm:text-2xl font-black text-red-600"><%= formatCurrency(total) %></span>
              </div>
            </div>

            <button type="submit" class="w-full gradient-cta text-white font-extrabold py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-center shadow-lg hover:opacity-95 transition mt-5 sm:mt-6 flex items-center justify-center gap-2 text-xs sm:text-sm">
              <i class="fas fa-lock text-xs"></i> ĐẶT HÀNG NGAY
            </button>

            <div class="flex items-center justify-center gap-3 sm:gap-4 mt-4 text-[10px] text-gray-400 flex-wrap">
              <span><i class="fas fa-shield-alt mr-1"></i> Bảo mật</span>
              <span><i class="fas fa-undo mr-1"></i> Đổi trả 30 ngày</span>
              <span><i class="fas fa-truck mr-1"></i> Giao toàn quốc</span>
            </div>
          </div>
        </div>

      </div>
    </form>
  </div>
</div>

<!-- Sticky Mobile Action Bar for Checkout -->
<div class="mobile-action-bar md:hidden fixed left-0 right-0 z-40 bg-white/95 backdrop-blur border-t border-gray-200 px-3 py-2.5 shadow-[0_-8px_20px_rgba(0,0,0,0.12)] flex items-center gap-3">
  <div class="flex-1 min-w-0">
    <span class="block text-[10px] uppercase tracking-wide font-bold text-gray-500">Tổng thanh toán</span>
    <span class="block text-base font-black text-red-600 leading-tight"><%= formatCurrency(total) %></span>
  </div>
  <button type="submit" form="checkout-form" class="gradient-cta text-white font-extrabold px-5 py-2.5 rounded-xl text-xs shadow-md flex items-center justify-center gap-1.5 active:scale-95 transition">
    <i class="fas fa-lock text-xs"></i> Đặt Hàng Ngay
  </button>
</div>

<script>
  document.body.classList.add('has-mobile-action-bar');

  function validatePhoneRealtime(input) {
    let val = input.value.replace(/[^\d+]/g, '');
    if (val.startsWith('+84')) {
      val = '0' + val.substring(3);
    }
    input.value = val;

    const statusEl = document.getElementById('phone-val-status');
    const iconEl = document.getElementById('phone-icon-check');
    const errEl = document.getElementById('phone-err-msg');
    const vnPhoneRegex = /^0(3|5|7|8|9)[0-9]{8}$/;

    if (!val) {
      if (statusEl) { statusEl.textContent = 'Định dạng chuẩn: 10 chữ số'; statusEl.className = 'text-[10px] sm:text-[11px] font-semibold text-gray-400'; }
      if (iconEl) iconEl.classList.add('hidden');
      if (errEl) errEl.classList.add('hidden');
      input.classList.remove('border-red-500', 'border-emerald-500', 'focus:ring-red-500');
      return false;
    }

    if (vnPhoneRegex.test(val)) {
      if (statusEl) { statusEl.textContent = '✓ Số điện thoại hợp lệ'; statusEl.className = 'text-[10px] sm:text-[11px] font-bold text-emerald-600'; }
      if (iconEl) iconEl.classList.remove('hidden');
      if (errEl) errEl.classList.add('hidden');
      input.classList.remove('border-red-500', 'focus:ring-red-500');
      input.classList.add('border-emerald-500');
      return true;
    } else {
      if (statusEl) { statusEl.textContent = '⚠️ Chưa đúng định dạng'; statusEl.className = 'text-[10px] sm:text-[11px] font-bold text-red-500'; }
      if (iconEl) iconEl.classList.add('hidden');
      if (errEl && val.length >= 10) errEl.classList.remove('hidden');
      else if (errEl) errEl.classList.add('hidden');
      input.classList.remove('border-emerald-500');
      input.classList.add('border-red-500', 'focus:ring-red-500');
      return false;
    }
  }

  document.getElementById('checkout-form')?.addEventListener('submit', function(e) {
    const phoneInput = document.getElementById('customer_phone');
    if (phoneInput && !validatePhoneRealtime(phoneInput)) {
      e.preventDefault();
      alert('Vui lòng nhập số điện thoại hợp lệ gồm 10 chữ số (bắt đầu bằng 03, 05, 07, 08, 09 - ví dụ: 0838709126) trước khi đặt hàng!');
      phoneInput.focus();
      return;
    }

    const btns = document.querySelectorAll('button[type="submit"]');
    btns.forEach(btn => {
      btn.disabled = true;
      btn.classList.add('opacity-75', 'cursor-not-allowed');
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ĐANG ĐẶT HÀNG...';
    });
  });

  function switchAddrTab(type) {
    const tabNew = document.getElementById('tab-addr-new');
    const tabOld = document.getElementById('tab-addr-old');
    const typeInput = document.getElementById('address_type');
    const addrInput = document.getElementById('customer_address');
    const hint = document.getElementById('addr-tab-hint');

    if (type === 'new') {
      typeInput.value = 'NEW';
      tabNew.className = 'py-2 px-1.5 sm:px-3 rounded-lg text-[10px] sm:text-xs font-bold transition flex items-center justify-center gap-1 text-center bg-white text-orange-600 shadow-sm border border-gray-200 min-w-0';
      tabOld.className = 'py-2 px-1.5 sm:px-3 rounded-lg text-[10px] sm:text-xs font-bold transition flex items-center justify-center gap-1 text-center text-gray-500 hover:text-gray-700 min-w-0';
      addrInput.placeholder = 'Nhập số nhà, tên đường, Phường/Xã mới (sau sáp nhập), Quận/Huyện, Tỉnh/Thành phố...';
      if (hint) hint.innerHTML = '💡 Bạn đang chọn nhập theo <strong class="text-orange-600">Địa chỉ đơn vị hành chính mới (Sau sáp nhập)</strong>.';
    } else {
      typeInput.value = 'OLD';
      tabOld.className = 'py-2 px-1.5 sm:px-3 rounded-lg text-[10px] sm:text-xs font-bold transition flex items-center justify-center gap-1 text-center bg-white text-orange-600 shadow-sm border border-gray-200 min-w-0';
      tabNew.className = 'py-2 px-1.5 sm:px-3 rounded-lg text-[10px] sm:text-xs font-bold transition flex items-center justify-center gap-1 text-center text-gray-500 hover:text-gray-700 min-w-0';
      addrInput.placeholder = 'Nhập số nhà, tên đường, Xã/Phường cũ, Huyện/Quận cũ, Tỉnh/Thành phố cũ...';
      if (hint) hint.innerHTML = '💡 Bạn đang chọn nhập theo <strong class="text-orange-600">Địa chỉ đơn vị hành chính cũ</strong> (Shop sẽ hỗ trợ đối soát địa chỉ giao đến tận nơi).';
    }
  }
</script>

<%- include('../partials/footer') %>
